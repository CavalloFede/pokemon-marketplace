# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pokemon_marketplace

# Redis
REDIS_URL=redis://localhost:6379

# Firebase Admin (Backend)
FIREBASE_PROJECT_ID=pokemon-marketplace
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# App
NODE_ENV=development
LOG_LEVEL=debug

# Frontend Firebase
VITE_API_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=pokemon-marketplace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pokemon-marketplace
VITE_FIREBASE_STORAGE_BUCKET=pokemon-marketplace.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
